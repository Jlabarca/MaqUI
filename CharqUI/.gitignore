# TextMeshPro — keep source, ignore baked atlas caches if regenerated at runtime
# (comment out if you want to commit baked atlases)
# /[Aa]ssets/TextMesh Pro/Resources/Fonts & Materials/

# Asset Store & third-party package imports (binaries committed to Assets/Packages)
# Keep .meta files — Unity needs them for GUIDs

# NuGet restore (if using NuGetForUnity)
/[Aa]ssets/[Pp]ackages/*.nupkg

# Crashlytics
crashlytics-build.properties

# Yarn Spinner (if used)
/[Aa]ssets/[Yy]arn[Ss]inner/*/Localisation/

